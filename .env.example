# Nhost (existing)
# NEXT_PUBLIC_NHOST_AUTH_URL=https://xxx.auth.region.nhost.run/v1
# NEXT_PUBLIC_NHOST_GRAPHQL_URL=...

# Finanzas: GraphQL Hasura — root field por defecto finance_profiles (tras Track en Hasura).
# NEXT_PUBLIC_HASURA_FINANCE_TABLE=finance_profiles
# NEXT_PUBLIC_HASURA_FINANCE_PKEY=finance_profiles_pkey
#
# Solo API LibSQL sin Hasura para finanzas:
# NEXT_PUBLIC_FINANCE_REMOTE=rest

# Local DB: LibSQL / Turso-compatible URL (solo con NEXT_PUBLIC_FINANCE_REMOTE=rest; por defecto file:.data/nimbus-finance.db)
# DATABASE_URL=file:.data/nimbus-finance.db
# TURSO_AUTH_TOKEN=

# If JWKS cannot be derived from NEXT_PUBLIC_NHOST_AUTH_URL:
# NHOST_JWKS_URL=https://xxx.auth.region.nhost.run/v1/.well-known/jwks.json
# If verification fails, set issuer from your JWT `iss` claim:
# NHOST_JWT_ISSUER=
